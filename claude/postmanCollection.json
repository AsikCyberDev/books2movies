{
	"info": {
		"name": "Book to Movie Platform API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register Reader",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"reader@example.com\",\n    \"password\": \"password123\",\n    \"username\": \"bookworm\",\n    \"role\": \"reader\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"path": ["api", "auth", "register"]
						}
					}
				},
				{
					"name": "Register Director",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"director@example.com\",\n    \"password\": \"password123\",\n    \"username\": \"filmmaker\",\n    \"role\": \"director\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"path": ["api", "auth", "register"]
						}
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"reader@example.com\",\n    \"password\": \"password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"path": ["api", "auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "Book Suggestions",
			"item": [
				{
					"name": "Create Suggestion",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{readerToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"The Silent Echo\",\n    \"author\": \"Elizabeth Matthews\",\n    \"isbn\": \"9781234567890\",\n    \"pitch\": \"This gripping mystery would translate perfectly to screen.\",\n    \"genre\": [\"thriller\", \"mystery\"],\n    \"publicationYear\": 2023\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/suggestions",
							"path": ["api", "suggestions"]
						}
					}
				},
				{
					"name": "Get All Suggestions",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/suggestions?genre=thriller&status=approved",
							"path": ["api", "suggestions"],
							"query": [
								{
									"key": "genre",
									"value": "thriller"
								},
								{
									"key": "status",
									"value": "approved"
								}
							]
						}
					}
				},
				{
					"name": "Get Single Suggestion",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/suggestions/{{suggestionId}}",
							"path": ["api", "suggestions", "{{suggestionId}}"]
						}
					}
				},
				{
					"name": "Upvote Suggestion",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{directorToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/suggestions/{{suggestionId}}/upvote",
							"path": ["api", "suggestions", "{{suggestionId}}", "upvote"]
						}
					}
				}
			]
		},
		{
			"name": "Comments",
			"item": [
				{
					"name": "Add Comment",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{directorToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"content\": \"This would make an excellent film adaptation!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/comments/{{suggestionId}}",
							"path": ["api", "comments", "{{suggestionId}}"]
						}
					}
				},
				{
					"name": "Get Comments",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/comments/{{suggestionId}}",
							"path": ["api", "comments", "{{suggestionId}}"]
						}
					}
				}
			]
		},
		{
			"name": "Search",
			"item": [
				{
					"name": "Search Suggestions",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/search?q=thriller mystery&genre=thriller&minUpvotes=1",
							"path": ["api", "search"],
							"query": [
								{
									"key": "q",
									"value": "thriller mystery"
								},
								{
									"key": "genre",
									"value": "thriller"
								},
								{
									"key": "minUpvotes",
									"value": "1"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "Admin",
			"item": [
				{
					"name": "Get Pending Suggestions",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/admin/suggestions/pending",
							"path": ["api", "admin", "suggestions", "pending"]
						}
					}
				},
				{
					"name": "Update Suggestion Status",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"approved\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/suggestions/{{suggestionId}}/status",
							"path": ["api", "admin", "suggestions", "{{suggestionId}}", "status"]
						}
					}
				}
			]
		},
		{
			"name": "Notifications",
			"item": [
				{
					"name": "Get User Notifications",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{readerToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/notifications",
							"path": ["api", "notifications"]
						}
					}
				},
				{
					"name": "Mark Notification as Read",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{readerToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/notifications/{{notificationId}}/read",
							"path": ["api", "notifications", "{{notificationId}}", "read"]
						}
					}
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000",
			"type": "string"
		},
		{
			"key": "readerToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "directorToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "adminToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "suggestionId",
			"value": "",
			"type": "string"
		},
		{
			"key": "notificationId",
			"value": "",
			"type": "string"
		}
	]
}